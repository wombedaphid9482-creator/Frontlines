{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frontlines-private-relay",
  "main": "../network/cloudflare-worker.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "FrontlinesRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FrontlinesRoom"] }],
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1311001", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": false }
}
